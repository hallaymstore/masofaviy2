PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/masofaviy2
JWT_SECRET=replace-with-at-least-32-random-characters
TOTP_ENCRYPTION_KEY=replace-with-a-separate-32-plus-character-random-key
ADMIN_LOGIN=admin
ADMIN_PASSWORD=ChangeMe123!
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=40100
TURN_URLS=turn:turn.example.uz:3478,turns:turn.example.uz:5349
TURN_USERNAME=
TURN_CREDENTIAL=

# Uzbekistan local time (+05:00) and attendance late threshold
APP_UTC_OFFSET_MINUTES=300
LATE_AFTER_MINUTES=5
PUBLIC_TIMETABLE_ENABLED=false
# Production compliance: student/teacher login only after audited in-person identity verification
REQUIRE_IN_PERSON_IDENTITY=true
SFU_BRIDGE_URL=
SFU_BRIDGE_SECRET=

# Login brute-force protection
LOGIN_MAX_ATTEMPTS=7
LOGIN_WINDOW_MS=900000

# Comma-separated browser origins. Example: https://masofaviy2-hallaym.onrender.com,https://edu.example.uz
ALLOWED_ORIGINS=


# Course resource upload limit (MB, max 1024)
MAX_RESOURCE_MB=1024

# Optional outbound e-mail bridge. Endpoint must accept POST JSON {to,subject,text,metadata}.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_SECRET=
