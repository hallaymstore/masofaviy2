PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/masofaviy2
JWT_SECRET=replace-with-at-least-32-random-characters
TOTP_ENCRYPTION_KEY=replace-with-a-separate-32-plus-character-random-key
ADMIN_LOGIN=admin
ADMIN_PASSWORD=ChangeMe123!
TURN_URLS=turn:turn.example.uz:3478,turns:turn.example.uz:5349
TURN_USERNAME=
TURN_CREDENTIAL=

# Uzbekistan local time (+05:00) and attendance late threshold
APP_UTC_OFFSET_MINUTES=300
LATE_AFTER_MINUTES=5
PUBLIC_TIMETABLE_ENABLED=false
# Production compliance: configured roles login only after audited in-person registration/identity verification
REQUIRE_IN_PERSON_IDENTITY=true
# VM 559, 21-band default: shaxsan ro‘yxatdan o‘tish talabi talaba uchun. Qo‘shimcha ichki siyosat bo‘lsa vergul bilan rollar qo‘shiladi.
IN_PERSON_IDENTITY_ROLES=student
SFU_BRIDGE_URL=
SFU_BRIDGE_SECRET=

# Login brute-force protection
LOGIN_MAX_ATTEMPTS=7
LOGIN_WINDOW_MS=900000

# Comma-separated browser origins. Example: https://masofaviy2-hallaym.onrender.com,https://edu.example.uz
ALLOWED_ORIGINS=


# Course resource upload limit (MB, max 1024)
MAX_RESOURCE_MB=1024

# Optional outbound e-mail bridge. Endpoint must accept POST JSON {to,subject,text,metadata}.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_SECRET=


# Official monitoring integration readiness (VM 559, 29-band).
# Live sync stays blocked until the university has approved API/gateway contracts and exact field schemas.
INSTITUTION_CODE=
MONITORING_MINISTRY_URL=
MONITORING_MINISTRY_TOKEN=
MONITORING_MINISTRY_SCHEMA_VERSION=
MONITORING_MINISTRY_OFFICIAL_CONTRACT_CONFIRMED=false
MONITORING_QUALITY_URL=
MONITORING_QUALITY_TOKEN=
MONITORING_QUALITY_SCHEMA_VERSION=
MONITORING_QUALITY_OFFICIAL_CONTRACT_CONFIRMED=false
MONITORING_MAX_PAYLOAD_MB=8
MONITORING_TIMEOUT_MS=20000

# Production backups are required to be encrypted.
BACKUP_GPG_RECIPIENT=
REQUIRE_ENCRYPTED_BACKUPS=true
RETENTION_DAYS=14
