# Application-side SFU cluster routing
SFU_BRIDGE_URLS=ws://10.10.20.11:41000,ws://10.10.20.12:41000,ws://10.10.20.13:41000
SFU_BRIDGE_SECRET=CHANGE_TO_A_LONG_RANDOM_32_PLUS_CHAR_SECRET
SFU_HEALTH_POLL_MS=5000
SFU_NODE_STALE_MS=15000

# Shared capacity target
TARGET_PARALLEL_ROOMS=50
MAX_ACTIVE_ROOMS=60
MAX_TOTAL_PEERS=1500
MAX_PEERS_PER_ROOM=40

# Per SFU node
MEDIASOUP_WORKERS=8
TARGET_MIN_WORKERS=8
MAX_ROOMS_PER_WORKER=8
RTC_BASE_PORT=50990
ENABLE_RTC_TCP=true
MAX_INCOMING_BITRATE=1500000
LECTURE_LITE_ENABLED=true
LECTURE_MAX_STUDENT_AUDIO=6
LECTURE_INITIAL_OUTGOING_BITRATE=700000

# Each SFU node MUST override these
# SFU_NODE_ID=sfu-01
# ANNOUNCED_IP=<public-or-routable-ip>
# SIGNAL_IP=0.0.0.0
# SIGNAL_PORT=41000
# RTC_LISTEN_IP=0.0.0.0