# Mediasoup SFU production environment
NODE_ENV=production

# Signaling is used only by the local Masofaviy2 backend bridge.
SIGNAL_IP=127.0.0.1
SIGNAL_PORT=40000

# WebRTC transports must listen on all interfaces and announce the public IP.
RTC_LISTEN_IP=0.0.0.0
ANNOUNCED_IP=YOUR_PUBLIC_IP
RTC_BASE_PORT=50000
MEDIASOUP_WORKERS=4
ENABLE_RTC_TCP=false

# Local platform validation endpoint.
PLATFORM_VERIFY_URL=http://127.0.0.1:3000/api/media/verify

# MUST exactly match the root .env SFU_BRIDGE_SECRET and be at least 32 random characters.
SFU_BRIDGE_SECRET=replace-with-the-same-32-plus-character-random-secret

MAX_PEERS_PER_ROOM=120
MAX_INCOMING_BITRATE=2500000
MEDIASOUP_LOG_LEVEL=warn
