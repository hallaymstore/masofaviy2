{
  "name": "masofaviy2",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node --check server.js && node --check lms.js && node --check scorm.js && node --check resource-upload.js && node --check academic-records.js && node --check library.js && node --check public/app.js && node --check public/sw.js",
    "test": "node --test tests/*.test.js",
    "prestart": "npm run build:media-client && npm run check",
    "build:media-client": "esbuild frontend/media-client.js --bundle --format=iife --global-name=MasofaviyMediaClientBundle --outfile=public/media-client.bundle.js --minify --target=es2020"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@mediapipe/face_detection": "^0.4.1646425229",
    "bcryptjs": "^3.0.2",
    "busboy": "^1.6.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.2",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.2.5",
    "file-type": "^21.3.4",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "mediasoup-client": "^3.18.7",
    "mongoose": "^8.18.0",
    "socket.io": "^4.8.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "esbuild": "^0.25.10"
  }
}
